{
  "name": "mush2",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web",
    "tools"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm run dev -w server\" \"npm run dev -w web\"",
    "test": "npm run test -w shared -w tools -w web",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build -w web",
    "ship-layout": "npm run ship-layout -w tools",
    "screenshot": "npm run screenshot -w tools --"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260930.2": true
  }
}

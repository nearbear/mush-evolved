{
  "name": "mush2",
  "private": true,
  "type": "module",
  "workspaces": [
    "Mush",
    "shared",
    "server",
    "web",
    "tools"
  ],
  "scripts": {
    "dev": "npm run dev -w tools",
    "preview": "npm run preview -w tools",
    "ports": "node tools/src/dev/ports.ts",
    "test": "npm run test -w shared -w tools -w web -w server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome lint .",
    "build": "npm run build -w web",
    "ship-layout": "npm run ship-layout -w tools",
    "asset-index": "npm run asset-index -w tools",
    "ods-data": "npm run ods-data -w tools",
    "screenshot": "npm run screenshot -w tools --",
    "ship-view": "npm run ship-view -w tools --",
    "contact-sheet": "npm run contact-sheet -w tools --"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260930.2": true
  }
}

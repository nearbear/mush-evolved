{
  "name": "mush2",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "Mush",
    "shared",
    "server",
    "web",
    "tools"
  ],
  "scripts": {
    "dev": "npm run dev -w tools",
    "preview": "npm run preview -w tools",
    "ports": "node tools/src/dev/ports.ts",
    "test": "npm run test -w shared -w tools -w web -w server",
    "test:browser": "npm run test:browser -w tools",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome lint .",
    "lint:md": "markdownlint-cli2",
    "verify": "node tools/src/dev/verify.ts",
    "build": "npm run build -w web",
    "deploy": "echo 'Pick a target: npm run deploy:production, deploy:staging or deploy:test' >&2 && exit 1",
    "deploy:production": "npm run build && npm run deploy:production -w server",
    "deploy:staging": "npm run build && npm run deploy:staging -w server",
    "deploy:test": "npm run build && npm run deploy:test -w server",
    "ship-layout": "npm run ship-layout -w tools",
    "layout-query": "npm run layout-query -w tools --",
    "ship-check": "npm run ship-check -w tools --",
    "asset-index": "npm run asset-index -w tools",
    "pip-bar": "npm run pip-bar -w tools",
    "ods-data": "npm run ods-data -w tools",
    "screenshot": "npm run screenshot -w tools --",
    "a11y": "npm run a11y -w tools --",
    "ship-view": "npm run ship-view -w tools --",
    "ship-render": "npm run ship-render -w tools --",
    "ship-top": "npm run ship-top -w tools --",
    "contact-sheet": "npm run contact-sheet -w tools --",
    "wiki": "npm run wiki -w tools --",
    "emush": "npm run emush -w tools --"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "concurrently": "^10.0.5",
    "markdownlint-cli2": "^0.24.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260930.2": true
  }
}

{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mush2-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // The web client, built by `npm run build`. Asset requests are served without
  // running the Worker; /parties/* (the WebSockets), /auth/* and /api/* (sign-in
  // and accounts) always go to the Worker.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/parties/*", "/auth/*", "/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "GameRoom", "class_name": "GameRoom" },
      { "name": "Matchmaker", "class_name": "Matchmaker" }
    ]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "mush2-production", "database_id": "9021775b-89ea-49f6-93d4-f1d5ed218ac4", "migrations_dir": "migrations" }
  ],
  // Which rules build ran a game, stored in its replay record. "dev" locally;
  // The deploy:* scripts override it with the commit hash.
  "vars": { "RULES_VERSION": "dev" },
  // Daily: deletes expired sessions and sign-ups (the scheduled handler in src/index.ts).
  "triggers": { "crons": ["17 4 * * *"] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom", "Matchmaker"] }],
  // The top level above is production. Wrangler does not inherit bindings, vars,
  // or migrations into an environment, so staging and test repeat them. Their
  // different Worker names give them their own Durable Object storage and secrets.
  // Test is staging with cheats and End cycle on (ALLOW_CHEATS), behind Cloudflare
  // Access. Never DEV_SERVER or MODEL_API_KEY on any deployment: no bot fill,
  // normal rate limits, no dev model key.
  "env": {
    "staging": {
      "name": "mush2-server-staging",
      "assets": {
        "directory": "../web/dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/parties/*", "/auth/*", "/api/*"]
      },
      "durable_objects": {
        "bindings": [
          { "name": "GameRoom", "class_name": "GameRoom" },
          { "name": "Matchmaker", "class_name": "Matchmaker" }
        ]
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "mush2-staging", "database_id": "ec315beb-a346-4507-a0ea-ae86795f023a", "migrations_dir": "migrations" }
      ],
      "vars": { "RULES_VERSION": "dev" },
      "triggers": { "crons": ["17 4 * * *"] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom", "Matchmaker"] }]
    },
    "test": {
      "name": "mush2-server-test",
      "assets": {
        "directory": "../web/dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/parties/*", "/auth/*", "/api/*"]
      },
      "durable_objects": {
        "bindings": [
          { "name": "GameRoom", "class_name": "GameRoom" },
          { "name": "Matchmaker", "class_name": "Matchmaker" }
        ]
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "mush2-test", "database_id": "600dcd0b-e9cf-4146-919a-0b01ef9d7568", "migrations_dir": "migrations" }
      ],
      "vars": { "RULES_VERSION": "dev", "ALLOW_CHEATS": "true" },
      "triggers": { "crons": ["17 4 * * *"] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom", "Matchmaker"] }]
    }
  }
}

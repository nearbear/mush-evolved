{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mush2-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // The web client, built by `npm run build`. Asset requests are served without
  // running the Worker; /parties/* (the WebSockets), /auth/*, /api/* (sign-in
  // and accounts) and /admin/* (operator tools) always go to the Worker.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/parties/*", "/auth/*", "/api/*", "/admin/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "GameRoom", "class_name": "GameRoom" },
      { "name": "Matchmaker", "class_name": "Matchmaker" }
    ]
  },
  "ratelimits": [
    // Per client IP or account, all of /auth/* and /api/*; sign-ups (new accounts, per IP) and setup posts (per account, #233) also count against tighter ones (rateLimit.ts).
    { "name": "AUTH_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "SIGNUP_LIMIT", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } },
    { "name": "SETUP_POST_LIMIT", "namespace_id": "1003", "simple": { "limit": 3, "period": 60 } }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "mush2-production", "database_id": "9021775b-89ea-49f6-93d4-f1d5ed218ac4", "migrations_dir": "migrations" }
  ],
  // Finished games' history for replays (#336, docs/ops/r2.md). The bucket must exist before a deploy.
  "r2_buckets": [{ "binding": "REPLAYS", "bucket_name": "mush2-replays-production" }],
  // Which rules build ran a game, stored in its replay record. "dev" locally;
  // The deploy:* scripts override it with the commit hash.
  "vars": { "RULES_VERSION": "dev" },
  // Daily: deletes expired sessions and sign-ups (the scheduled handler in src/index.ts).
  "triggers": { "crons": ["17 4 * * *"] },
  // Workers Logs (#430, docs/ops/observability.md). The redaction is required: the game socket's URL carries the
  // seat token (?token=), which would otherwise be stored with every connection. Issues groups uncaught exceptions,
  // a backstop for crashes log.ts never sees.
  "observability": { "enabled": true, "redact_query_string": true, "issues": { "enabled": true } },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom", "Matchmaker"] }],
  // The top level above is production. Wrangler does not inherit bindings, vars,
  // or migrations into an environment, so staging and test repeat them. Their
  // different Worker names give them their own Durable Object storage and secrets.
  // Test is staging with cheats and End cycle on (ALLOW_CHEATS), public since
  // 2026-11-08 (docs/ops/deploy.md). Never DEV_SERVER or MODEL_API_KEY on any deployment: no bot fill,
  // normal rate limits, no dev model key.
  "env": {
    "staging": {
      "name": "mush2-server-staging",
      "assets": {
        "directory": "../web/dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/parties/*", "/auth/*", "/api/*", "/admin/*"]
      },
      "durable_objects": {
        "bindings": [
          { "name": "GameRoom", "class_name": "GameRoom" },
          { "name": "Matchmaker", "class_name": "Matchmaker" }
        ]
      },
      "ratelimits": [
        // Per client IP or account, all of /auth/* and /api/*; sign-ups (new accounts, per IP) and setup posts (per account, #233) also count against tighter ones (rateLimit.ts).
        { "name": "AUTH_LIMIT", "namespace_id": "2001", "simple": { "limit": 60, "period": 60 } },
        { "name": "SIGNUP_LIMIT", "namespace_id": "2002", "simple": { "limit": 3, "period": 60 } },
        { "name": "SETUP_POST_LIMIT", "namespace_id": "2003", "simple": { "limit": 3, "period": 60 } }
      ],
      "d1_databases": [
        { "binding": "DB", "database_name": "mush2-staging", "database_id": "ec315beb-a346-4507-a0ea-ae86795f023a", "migrations_dir": "migrations" }
      ],
      // Finished games' history for replays (#336, docs/ops/r2.md). The bucket must exist before a deploy.
      "r2_buckets": [{ "binding": "REPLAYS", "bucket_name": "mush2-replays-staging" }],
      "vars": { "RULES_VERSION": "dev" },
      "triggers": { "crons": ["17 4 * * *"] },
      "observability": { "enabled": true, "redact_query_string": true, "issues": { "enabled": true } },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom", "Matchmaker"] }]
    },
    "test": {
      "name": "mush2-server-test",
      "assets": {
        "directory": "../web/dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/parties/*", "/auth/*", "/api/*", "/admin/*"]
      },
      "durable_objects": {
        "bindings": [
          { "name": "GameRoom", "class_name": "GameRoom" },
          { "name": "Matchmaker", "class_name": "Matchmaker" }
        ]
      },
      "ratelimits": [
        // Per client IP or account, all of /auth/* and /api/*; sign-ups (new accounts, per IP) and setup posts (per account, #233) also count against tighter ones (rateLimit.ts).
        { "name": "AUTH_LIMIT", "namespace_id": "3001", "simple": { "limit": 60, "period": 60 } },
        { "name": "SIGNUP_LIMIT", "namespace_id": "3002", "simple": { "limit": 3, "period": 60 } },
        { "name": "SETUP_POST_LIMIT", "namespace_id": "3003", "simple": { "limit": 3, "period": 60 } }
      ],
      "d1_databases": [
        { "binding": "DB", "database_name": "mush2-test", "database_id": "600dcd0b-e9cf-4146-919a-0b01ef9d7568", "migrations_dir": "migrations" }
      ],
      // Finished games' history for replays (#336, docs/ops/r2.md). The bucket must exist before a deploy.
      "r2_buckets": [{ "binding": "REPLAYS", "bucket_name": "mush2-replays-test" }],
      "vars": { "RULES_VERSION": "dev", "ALLOW_CHEATS": "true" },
      "triggers": { "crons": ["17 4 * * *"] },
      "observability": { "enabled": true, "redact_query_string": true, "issues": { "enabled": true } },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom", "Matchmaker"] }]
    }
  }
}

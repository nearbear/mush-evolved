{
  "name": "@mush2/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node -e \"require('node:fs').mkdirSync('../web/dist', { recursive: true })\" && wrangler dev",
    "types": "wrangler types",
    "deploy": "wrangler deploy --var RULES_VERSION:$(git describe --always --dirty --abbrev=40)",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mush2/shared": "*",
    "partyserver": "^0.5.10"
  },
  "devDependencies": {
    "wrangler": "^4.145.0",
    "vitest": "^5.0.3"
  }
}

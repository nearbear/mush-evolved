{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"files": {
		"includes": [
			"shared/src/**",
			"server/src/**",
			"web/src/**",
			"tools/src/**"
		]
	},
	"formatter": {
		"enabled": false
	},
	"assist": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "none",
			"correctness": {
				"useExhaustiveDependencies": "error",
				"useHookAtTopLevel": "error",
				"noUnusedImports": "error",
				"noUnusedVariables": "error",
				"noVoidTypeReturn": "error"
			},
			"nursery": {
				"noFloatingPromises": "error",
				"noMisusedPromises": "error"
			},
			"suspicious": {
				"noExplicitAny": "error",
				"noFallthroughSwitchClause": "error",
				"useIterableCallbackReturn": "error"
			},
			"a11y": {
				"useButtonType": "error",
				"useAriaPropsSupportedByRole": "error",
				"useKeyWithClickEvents": "error",
				"noStaticElementInteractions": "error",
				"noSvgWithoutTitle": "error",
				"noNoninteractiveTabindex": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": [
				"shared/src/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"react": "shared is pure rules code; no UI imports.",
									"react-dom": "shared is pure rules code; no UI imports."
								},
								"patterns": [
									{
										"group": [
											"node:*",
											"fs",
											"path",
											"http",
											"https",
											"net"
										],
										"message": "shared must stay free of I/O."
									},
									{
										"group": [
											"@mush2/web",
											"@mush2/server",
											"@mush2/tools"
										],
										"message": "shared must not depend on other packages."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"web/src/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@mush2/server",
											"@mush2/server/*"
										],
										"message": "web talks to the server over the protocol only."
									},
									{
										"group": [
											"pixi.js",
											"pixi.js/*"
										],
										"message": "Pixi stays behind the renderer seam, in web/src/iso/pixi/ (see web/src/iso/CLAUDE.md)."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"web/src/iso/pixi/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@mush2/server",
											"@mush2/server/*"
										],
										"message": "web talks to the server over the protocol only."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"server/src/**"
			],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": {
							"level": "error",
							"options": {
								"allow": [
									"warn",
									"error"
								]
							}
						}
					}
				}
			}
		}
	]
}
